{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sebrain",
  "version": "0.2.0",
  "identifier": "com.csi003.sebrain",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SeBrain",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      },
      {
        "label": "mini",
        "title": "SeBrain Focus",
        "url": "/?mode=mini",
        "width": 300,
        "height": 300,
        "minWidth": 280,
        "minHeight": 280,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "work-log",
        "title": "SeBrain — บันทึกการทำงาน",
        "url": "/?mode=work-log",
        "width": 460,
        "height": 310,
        "minWidth": 380,
        "minHeight": 260,
        "visible": false,
        "skipTaskbar": true
      },
      {
        "label": "task-detail",
        "title": "SeBrain — เคส",
        "url": "/?mode=task-detail",
        "width": 520,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
